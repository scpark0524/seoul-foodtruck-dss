# ==============================================================
# API Keys — 실제 키를 입력한 뒤 파일명을 .env 로 변경하여 사용
# (.env 파일은 절대 GitHub에 올리지 마세요. .gitignore 권장)
# ==============================================================

# ─── 서울 열린데이터광장 (멀티키 권장) ───────────────────────
# 팀원 4명이 각자 data.seoul.go.kr 회원가입 → 마이페이지 → 인증키 신청
# 4개 키 합산 4,000건/일 → 매시간(1,968건) 또는 매 30분(3,936건) 가능
SEOUL_API_KEY_1=
SEOUL_API_KEY_2=
SEOUL_API_KEY_3=
SEOUL_API_KEY_4=

# 키별 일일 한도 (마이페이지에서 확인 후 정확히 입력)
SEOUL_API_QUOTA_1=1000
SEOUL_API_QUOTA_2=1000
SEOUL_API_QUOTA_3=1000
SEOUL_API_QUOTA_4=1000

# ─── 공공데이터포털 (data.go.kr) ─────────────────────────────
DATA_GO_KR_KEY_ENC=
DATA_GO_KR_KEY_DEC=

# ─── (선택) KOSIS Open API ────────────────────────────────────
KOSIS_API_KEY=
